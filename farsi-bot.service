[Unit]
Description=Telegram Farsi voice transcription bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=server
Group=server
WorkingDirectory=/opt/farsi-bot
EnvironmentFile=/opt/farsi-bot/.env
ExecStart=/opt/farsi-bot/venv/bin/python /opt/farsi-bot/farsi_transcribe_bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
