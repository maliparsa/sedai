[Unit]
Description=Sedai Telegram bot (voice transcription & AI assistant)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=server
Group=server
WorkingDirectory=/opt/sedai-bot/telegram-bot
EnvironmentFile=/opt/sedai-bot/telegram-bot/.env
ExecStart=/opt/sedai-bot/telegram-bot/venv/bin/python /opt/sedai-bot/telegram-bot/sedai_bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
